{
 "compilerOptions": {
   "target":"ES2022", "lib":["DOM","DOM.Iterable","ESNext"],
   "skipLibCheck":true,"strict":true,"noEmit":true,"esModuleInterop":true,
   "module":"ESNext","moduleResolution":"bundler","types":["node","vite/client"],
   "resolveJsonModule":true,"isolatedModules":true,"jsx":"react-jsx",
   "paths":{"@/*":["./*"]}
 },
 "include":["app/**/*.ts","app/**/*.tsx","vite.config.ts"],
 "exclude":["node_modules","dist"]
}
